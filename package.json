{
  "name": "stylemuse",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:web": "pnpm --filter @stylemuse/web build",
    "build:api": "pnpm --filter @stylemuse/api build",
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @stylemuse/web dev",
    "dev:api": "pnpm --filter @stylemuse/api dev",
    "dev:mobile": "pnpm --filter @stylemuse/mobile start",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.7.3",
    "prettier": "^3.5.1"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=20.0.0"
  }
}
