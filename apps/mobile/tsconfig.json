{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
